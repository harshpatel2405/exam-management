# BatchFlow Backend Environment Variables Example

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/batchflow

# Authentication & JWT Configuration
JWT_SECRET=your-secure-jwt-secret-key-here
JWT_EXPIRES_IN=24h

# Email Service Configuration (Nodemailer SMTP settings)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=your-smtp-password
EMAIL_FROM="BatchFlow System" <noreply@batchflow.local>
